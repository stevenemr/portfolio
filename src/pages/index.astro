---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import Background from "../images/pexels-code-1839406_1920.jpg";

import CodeText from "../components/CodeText.astro";
import ButtonFilled from "../components/ButtonFilled.astro";
import ButtonBorder from "../components/ButtonBorder.astro";
import { Image } from "astro:assets";

import Steven from "../images/steven.jpeg";
import StevenProgramming from "../images/steven-programming.jpeg";
import Signature from "../images/signature.png";

import GehringEnKetelaarsLogo from "../images/company-logos/gehring-en-ketelaars.png";
import FloraliaLogo from "../images/company-logos/floralia.png";

import ProjectCard from "../components/ProjectCard.astro";

import GehringEnKetelaarsProject from "../images/projects/gehring-en-ketelaars.png";
import FloraliaVoorthuizenProject from "../images/projects/floralia-voorthuizen.png";

import WorkEducationCard from "../components/WorkEducationCard.astro";

// Work/Internship Images
import SosEventsLogo from "../images/work/sos-events.png";
import AventusLogo from "../images/work/aventus.png";
import LeisureKingLogo from "../images/work/leisureking.png";

// Education Images
import HanLogo from "../images/education/han.png";
import MheenparkLogo from "../images/education/mheenpark.png";

// Quote
import GehringEnKetelaarsQuote from "../images/quotes/gehring-en-ketelaars.png";
import Quote from "../components/Quote.astro";
---

<Layout>
	<Hero image={Background} alt="Coding image">
		<Image
			src={Steven}
			width={500}
			height={500}
			class="rounded-full h-30 w-30"
			alt="Steven Erik Martijn Roest"
		/>

		<div>
			<CodeText>
				<span class="text-sem-orange">*</span> Hello World is a developers
				first program
			</CodeText>

			<h1>
				Hello World<span class="text-sem-orange">*</span>,
				<br />
				I'm Steven
			</h1>
		</div>

		<p class="max-w-xl">
			20-year-old developer from Apeldoorn, The Netherlands 🇳🇱️
		</p>

		<p class="max-w-xl">
			Studying ICT at HAN University of Applied Sciences, graduated
			cum-laude from Software Development at Aventus Apeldoorn.
		</p>

		<p class="max-w-xl">
			Working at SOS Events as Full-Stack Developer and creating
			full-stack websites, dashboards and custom made applications.
		</p>

		<div class="flex flex-wrap gap-4">
			<ButtonFilled href="#">Download my CV &rarr;</ButtonFilled>
			<ButtonBorder href="#">Contact me</ButtonBorder>
		</div>
	</Hero>

	<div class="container" id="about">
		<div
			class="bg-white/16 grid grid-cols-1 lg:grid-cols-2 rounded-lg overflow-hidden mt-25"
		>
			<div class="p-8 order-2 lg:order-1">
				<h2 class="mb-3">About Me</h2>

				<div class="flex flex-col gap-5 mb-3">
					<p>
						Hello world! My name is Steven (Erik Martijn) Roest, a
						20 year old developer from Apeldoorn, the Netherlands
						🇳🇱. I expertise in Full-Stack web and software
						development, both for SOS Events and in my free time my
						own company: stevenem.
					</p>

					<p>
						Since I was young, I only could talk about computers.
						When I was around 9 years old, I already made some of my
						first code and now 11 years later, it has not left me.
						In 2022, after graduating from the MAVO, I started my
						course Software Development at Aventus in Apeldoorn.
						After doing four years in three years, and graduating
						cum-laude, I started the course ICT at the HAN
						University of Applied Sciences in Arnhem in 2025.
					</p>

					<p>
						Next to school, I work at SOS Events. After two
						successful internships and a side job, I signed my fixed
						contract in 2025.
					</p>
				</div>

				<Image src={Signature} alt={"Signature of Steven Roest"} />
			</div>

			<div class="relative order-1 lg:order-2">
				<Image
					src={StevenProgramming}
					class="w-full h-full object-cover"
					alt="Steven behind a PC programming"
				/>

				<div
					class="absolute inset-0 bg-linear-to-t lg:bg-linear-to-r from-sem-light-gray to-transparent"
				>
				</div>
			</div>
		</div>
	</div>

	<div class="container flex flex-wrap justify-center gap-x-3 gap-y-5 mt-25">
		<Image
			src={GehringEnKetelaarsLogo}
			alt={"Logo of Gehring en Ketelaars"}
		/>
		<Image src={FloraliaLogo} alt={"Logo of Floralia Voorthuizen"} />
	</div>

	<div class="container mt-25" id="projects">
		<div class="text-center mb-10">
			<CodeText>The work I'm proud of</CodeText>
			<h2>Projects</h2>
		</div>

		<div class="flex flex-col gap-20">
			<ProjectCard
				image={GehringEnKetelaarsProject}
				title="Website Gehring en Ketelaars"
				period="Feb 2025"
				tags={["WordPress", "Bootstrap", "Custom Theme"]}
				viewLink="https://gehringenketelaars.nl"
			>
				<p>
					Realised my first professional web development project for
					Theaterduo Gehring en Ketelaars, focusing on easy content
					management. Built using WordPress, the most popular CMS in
					the world.
				</p>
			</ProjectCard>

			<ProjectCard
				image={FloraliaVoorthuizenProject}
				title="Floralia Voorthuizen Votingwebsite"
				period="2024-now"
				tags={[
					"PHP",
					"TailwindCSS",
					"Dashboard development",
					"Full-stack",
				]}
				viewLink="https://gehringenketelaars.nl"
				reverse
			>
				<p>
					In 2024 I created a voting website for the Floralia
					Voorthuizen Bloemencorso (flower parade). Five thousand
					tickets were handed to the public, so they can vote for
					their favorite flower wagons. Each year I have made some
					updates.
				</p>
			</ProjectCard>
		</div>
	</div>

	<div class="container mt-25" id="work-experience">
		<div class="text-center mb-10">
			<CodeText>Companies I've worked for and internships</CodeText>
			<h2>Work Experience</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
			<WorkEducationCard
				image={SosEventsLogo}
				title="SOS Events"
				jobFunction="Full-Stack Developer"
				period="Aug 2025 - now"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Creating websites with Laravel, creating data dashboards, AI
				integrations and custom made applications.
			</WorkEducationCard>

			<WorkEducationCard
				image={AventusLogo}
				title="Aventus"
				jobFunction="Examinator"
				period="Dec 2025 - Jan 2026"
				tags={["React Native", "Exams"]}
			>
				Examinated two days (one in December, one in January) for the
				course ‘Mobile Application Development’. Helped the first
				examinator with questions and forms.
			</WorkEducationCard>

			<WorkEducationCard
				image={LeisureKingLogo}
				title="LeisureKing"
				jobFunction="Internship"
				period="Feb 2025 - Jun 2025"
				tags={["Python", "Machine Learning", "Artificial Intelligence"]}
			>
				Creating a Machine Learned application that predicts the amount
				of customers on a day.
			</WorkEducationCard>

			<WorkEducationCard
				image={SosEventsLogo}
				title="SOS Events"
				jobFunction="Side Job Development"
				period="Feb 2024 - Feb 2025"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Daily PHP development across 30+ managed websites. Building
				dashboards, custom CMS solutions, and event management tools.
			</WorkEducationCard>

			<WorkEducationCard
				image={SosEventsLogo}
				title="SOS Events"
				jobFunction="Internship Webdevelopment"
				period="Aug 2023 - Feb 2024"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Daily PHP development across 30+ managed websites. Building
				dashboards, custom CMS solutions, and event management tools.
			</WorkEducationCard>
		</div>
	</div>

	<div class="container mt-25" id="work-experience">
		<div class="text-center mb-10">
			<CodeText>Where I've learned developing</CodeText>
			<h2>Education</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
			<WorkEducationCard
				image={HanLogo}
				title="HAN University"
				jobFunction="ICT - HBO Bachelor"
				period="Aug 2025 - now"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Specializing in Software Development
			</WorkEducationCard>

			<WorkEducationCard
				image={AventusLogo}
				title="Aventus"
				jobFunction="Software Developer"
				period="Aug 2022 - Jun 2025"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Graduated cum laude, did four years in three years.
			</WorkEducationCard>

			<WorkEducationCard
				image={MheenparkLogo}
				title="Veluws College Mheenpark"
				jobFunction="MAVO"
				period="Aug 2018 - Jun 2022"
				tags={["Laravel", "Tailwind", "Custom Dashboards"]}
			>
				Graduated with Economics and Techology profiles.
			</WorkEducationCard>
		</div>
	</div>

	<div class="container mt-25">
		<Quote
			author="Gehring en Ketelaars"
			authorImage={GehringEnKetelaarsQuote}
		>
			Steven was ontzettend behulpzaam, vriendelijk en altijd goed
			bereikbaar. Met veel geduld en toewijding ging hij aan de slag, ook
			met onderdelen die nieuw voor hem waren. Hij bleef net zo lang
			puzzelen tot alles klopte – en met resultaat: hij heeft een
			prachtige website gemaakt die niet alleen mooi en uitnodigend is,
			maar ook zeer gebruiksvriendelijk. Wij zijn er ontzettend blij mee
			en raden Steven van harte aan!

			<a
				href="https://www.gehringenketelaars.nl"
				class="underline text-sem-orange"
				slot="sub-author"
			>
				www.gehringenketelaars.nl
			</a>
		</Quote>
	</div>

	<div class="mt-25"></div>
</Layout>
