---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import BlogImage from "../images/edar-diary-968592_1920.jpg";
import CodeText from "../components/CodeText.astro";
import ButtonFilled from "../components/ButtonFilled.astro";
import BlogCard from "../components/BlogCard.astro";

const allPosts = Object.values(
    import.meta.glob("./blog/*.md", { eager: true }),
);
---

<Layout
    title="Development blog written by Steven | stevenem"
    description="In this blog I write about things I built, learned, or just felt like writing about."
>
    <Hero image={BlogImage} alt="Blog writing image">
        <div>
            <CodeText>Welcome to my Blog</CodeText>
            <h1>Blog</h1>
        </div>

        <p>Things I built, learned, or just felt like writing about.</p>

        <ButtonFilled href="#blog">
            Show articles
            {" "}
            <i class="fa-solid fa-arrow-down"></i>
        </ButtonFilled>
    </Hero>

    <section
        class="container grid grid-cols-1 md:grid-cols-2 gap-10 py-25"
        id="blog"
    >
        {
            allPosts.map((post: any) => (
                <BlogCard
                    image={post.frontmatter.image.url}
                    alt={post.frontmatter.image.alt}
                    title={post.frontmatter.title}
                    tags={post.frontmatter.tags}
                    date={new Date(post.frontmatter.pubDate)}
                    summary={post.frontmatter.summary}
                    href={post.url}
                />
            ))
        }
    </section>
</Layout>
