---
interface Props {
    name: string;
    placeholder?: string;
    label?: string;
    required?: boolean;
}

const { name, placeholder, label = null, required = false } = Astro.props;
---

<div class="flex flex-col gap-2 items-start">
    {label ? <label for={name}>{label}:</label> : null}

    <textarea
        name={name}
        id={name}
        placeholder={placeholder}
        class="bg-sem-light-gray border-2 border-sem-gray p-3 rounded-lg placeholder-sem-gray w-full min-h-40"
        required={required}></textarea>
</div>
