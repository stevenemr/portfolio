---
import Tag from "./Tag.astro";
import ButtonBorder from "./ButtonBorder.astro";
import { Image } from "astro:assets";

interface Props {
    image?: ImageMetadata;
    alt?: string;
    title: string;
    tags: string[];
    date: Date;
    summary: string;
    href: string;
}

import NoImage from "../images/no-image.svg";

const {
    image = NoImage,
    alt = "",
    title,
    tags = [],
    date,
    summary,
    href,
} = Astro.props;
---

<article class="relative rounded-lg overflow-hidden">
    <Image
        src={image}
        class="w-full aspect-1/1.5 md:aspect-video object-cover"
        alt={alt ?? title}
    />

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-linear-to-b from-transparent to-sem-black">
    </div>

    <div
        class="absolute bottom-5 left-5 right-5 flex flex-wrap justify-between items-end gap-y-3"
    >
        <div>
            <h3 class="mb-2">{title}</h3>

            <div class="flex flex-wrap gap-2 items-center mb-2">
                {tags.map((tag) => <Tag>{tag}</Tag>)}
                <p>&bull;</p>
                <p>
                    {
                        date.toLocaleDateString("en-US", {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                        })
                    }
                </p>
            </div>

            <p>{summary}</p>
        </div>

        <ButtonBorder href={href}>
            Read
            {" "}
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </ButtonBorder>
    </div>
</article>
