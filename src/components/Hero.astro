---
import { Image } from "astro:assets";

interface Props {
	image: ImageMetadata | string;
	alt?: string;
}

const { image, alt = "Hero image" } = Astro.props;
---

<div class="relative min-h-screen min-h-dvh">
	<div class="absolute inset-0 lg:left-1/2">
		{
			typeof image === "string" ? (
				<img
					src={image}
					alt={alt}
					class="h-full w-full object-cover brightness-50"
					loading="eager"
				/>
			) : (
				<Image
					src={image}
					alt={alt}
					class="h-full w-full object-cover brightness-50"
					loading="eager"
				/>
			)
		}

		<div
			class="absolute inset-0 bg-linear-to-b from-transparent to-sem-black"
		>
		</div>
	</div>

	<div
		class="relative z-10 container min-h-screen min-h-dvh grid grid-cols-1 lg:grid-cols-2 gap-10 pt-36 pb-16"
	>
		<div class="flex flex-col items-start gap-5 my-auto">
			<slot />
		</div>
	</div>
</div>
